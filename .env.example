# Выбор провайдера: "openrouter" или "lmstudio" (по умолчанию: lmstudio, либо openrouter если указан ключ)
API_PROVIDER=openrouter

# Ключ OpenRouter (получить бесплатно на https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Опционально) Кастомные модели:
# Бесплатные модели на OpenRouter:
# VISION_MODEL=google/gemini-2.0-flash-exp:free
# STEP1_MODEL=google/gemini-2.0-flash-exp:free
# STEP2_MODEL=google/gemini-2.0-flash-exp:free
